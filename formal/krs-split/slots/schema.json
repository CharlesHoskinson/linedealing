{
  "capability": "split-slots",
  "types": {
    "NN": {"tuple": "P", "items": ["int", "int"], "names": ["a", "b"]},
    "Mode": {"enum": {"TEE": "Tee", "NON_TEE": "NonTee"}},
    "Suite": {"enum": {"BIP340": "Bip340", "ED25519": "Ed25519"}},
    "BStat": {"enum": {"UNNAMED": "Unnamed", "NAMED": "Named", "RESERVED": "Reserved",
                       "CLAIMED": "Claimed", "BURNED": "Burned"}},
    "Root": {"enum": {"OWN": "Own", "G": "Gr"}},
    "Params": {"record": "Params", "fields": [["mode", "mode", {"ref": "Mode"}], ["w", "w", "int"]]},
    "CKey": {"record": "Ck", "fields": [["suite", "suite", {"ref": "Suite"}], ["epoch", "epoch", "int"],
                                       ["idx", "idx", "int"]]},
    "EKey": {"record": "Ek", "fields": [["pool", "pool", "int"], ["idx", "idx", "int"]]},
    "CSlot": {"record": "Cs", "fields": [
      ["suite", "suite", {"ref": "Suite"}], ["epoch", "epoch", "int"], ["idx", "idx", "int"],
      ["bstat", "bstat", {"ref": "BStat"}], ["prec", "prec", {"option": "int"}],
      ["namers", "namers", {"list": {"ref": "NN"}}]]},
    "ESlot": {"record": "Es", "fields": [
      ["pool", "pool", "int"], ["idx", "idx", "int"], ["leaf_set", "leaf_set", "int"],
      ["root", "root", {"ref": "Root"}], ["bstat", "bstat", {"ref": "BStat"}],
      ["prec", "prec", {"option": "int"}], ["reserver", "reserver", {"option": "int"}],
      ["namers", "namers", {"list": {"ref": "NN"}}]]},
    "SeatSt": {"union": {"strings": {"free": "Free", "burned": "SBurned"},
                         "keyed": {"bound": ["Bound", [[null, "d", "int"]]]}}},
    "SeatSlot": {"record": "Ss", "fields": [
      ["key", "key", "int"], ["st", "st", {"ref": "SeatSt"}], ["current", "current", "bool"],
      ["signed", "signed", {"list": "int"}]]},
    "Force": {"record": "Frc", "fields": [["eid", "eid", "int"], ["root", "root", {"ref": "Root"}]]},
    "Dealer": {"record": "Dlr", "fields": [["dealer", "dealer", "int"], ["complained", "complained", "bool"]]},
    "Refusal": {"enum": {"no-rule": "NoRule", "outside-capability": "OutsideCapability",
                         "slot_bound": "SlotBound"}},
    "Verdict": {"enum": {"in_window": "InWindow", "SLOT_TAKEN": "SlotTaken", "above_window": "AboveWindow",
                         "pool_unlisted": "PoolUnlisted"}},
    "VoidReason": {"enum": {"SLOT_TAKEN": "VSlotTaken"}},
    "Op": {"variant": {"tag": "op", "cases": {
      "deal_c": ["DealC", [["suite", "suite", {"ref": "Suite"}], ["epoch", "epoch", "int"], ["k", "kcount", "int"]]],
      "deal_e": ["DealE", [["pool", "pool", "int"], ["leaf_set", "leaf_set", "int"], ["root", "root", {"ref": "Root"}],
                           ["k", "kcount", "int"]]],
      "open_c": ["OpenC", [["eid", "eid", "int"], ["pos", "pos", "int"], ["names", "names", {"list": {"ref": "CKey"}}]]],
      "open_e": ["OpenE", [["eid", "eid", "int"], ["pos", "pos", "int"], ["names", "names", {"list": {"ref": "EKey"}}]]],
      "in_force": ["InForce", [["eid", "eid", "int"], ["root", "root", {"ref": "Root"}]]],
      "lapse": ["Lapse", [["eid", "eid", "int"]]],
      "reserve": ["Reserve", [["eid", "eid", "int"]]],
      "claim": ["ClaimOp", [["eid", "eid", "int"]]],
      "end": ["EndReq", [["eid", "eid", "int"]]],
      "burn_range": ["BurnRange", [["suite", "suite", {"ref": "Suite"}], ["epoch", "epoch", "int"],
                                   ["lo", "lo", "int"], ["hi", "hi", "int"]]],
      "burn_pool": ["BurnPool", [["pool", "pool", "int"]]],
      "seat_put": ["SeatPut", [["key", "key", "int"]]],
      "seat_bind": ["SeatBind", [["key", "key", "int"], ["d", "d", "int"], ["slot_acks", "slot_acks", "int"],
                                 ["sealed_acks", "sealed_acks", "int"]]],
      "seat_release": ["SeatRelease", [["key", "key", "int"], ["d", "d", "int"]]],
      "seat_burn": ["SeatBurn", [["key", "key", "int"]]],
      "judge": ["Judge", [["listed", "listed", "bool"], ["h", "h", "int"], ["pending_min", "pending_min", "int"],
                          ["pending", "pending", {"list": {"ref": "NN"}}], ["B", "bw", "int"], ["eid", "eid", "int"],
                          ["idxs", "idxs", {"list": "int"}]]],
      "batch": ["Batch", [["polys", "polys", {"list": "bool"}]]],
      "qualify": ["Qualify", [["t", "t", "int"], ["dealers", "dealers", {"list": {"ref": "Dealer"}}]]],
      "anchor_gate": ["AnchorGate", [["on", "on", "bool"], ["covered", "covered", {"list": {"ref": "NN"}}],
                                     ["nf", "nf", "int"], ["d", "d", "int"]]]}}},
    "Obs": {"keyed": {
      "ok": ["Ok", null],
      "refused": ["Refused", [[null, "codes", {"list": {"ref": "Refusal"}}]]],
      "void": ["Void", [[null, "reason", {"ref": "VoidReason"}]]],
      "released": ["Released", [[null, "d", "int"]]],
      "verdicts": ["Verdicts", [[null, "vs", {"list": {"ref": "Verdict"}}]]],
      "complaint": ["Complaint", [[null, "failing", {"list": "int"}]]],
      "qualified": ["Qualified", [[null, "ds", {"option": {"list": "int"}}]]],
      "gate": ["Gate", [[null, "pass", "bool"]]]}}
  },
  "inputs": [
    ["params", {"ref": "Params"}],
    ["ops", {"list": {"ref": "Op"}}]
  ],
  "state": [
    ["params", "params", {"ref": "Params"}],
    ["cslots", "cslots", {"list": {"ref": "CSlot"}}],
    ["eslots", "eslots", {"list": {"ref": "ESlot"}}],
    ["seat", "seat", {"list": {"ref": "SeatSlot"}}],
    ["in_force", "forces", {"list": {"ref": "Force"}}],
    ["opened", "opened", {"list": "int"}],
    ["last_pos", "lastpos", {"option": "int"}],
    ["lapsed", "lapsed", {"list": "int"}],
    ["ended", "ended", {"list": "int"}]
  ],
  "obs": {"ref": "Obs"}
}
