  syntax KItem ::= Run

  // KRS split-envelope-reference/src/lib.rs: Machine
  configuration
    <k> # run </k>
    <params> $PARAMS:Params </params>
    <height> $HEIGHT:Int </height>
    <epochs> $EPOCHS:List </epochs>
    <seen> .List </seen>
    <accepted> .List </accepted>
    <ops> $OPS:List </ops>
    <obs> .List </obs>


  // KRS split-envelope-reference/src/lib.rs: combine
  rule [combine]:
    <k> # run ... </k>
    <ops> ListItem(combine ( T:Int , DealingOk:Bool , Partials:List )) Krs_RestOps:List => Krs_RestOps:List </ops>
    <obs> Obs:List => Obs:List ListItem(combined ( combineOf ( T:Int , DealingOk:Bool , Partials:List ) )) </obs>
    requires notBool ((T:Int ==Int 0) orElseBool (notBool nodupB ( senders ( Partials:List ) )))
  // KRS split-envelope-reference/src/lib.rs: combine_outside
  rule [combine-outside]:
    <k> # run ... </k>
    <ops> ListItem(combine ( T:Int , _ , Partials:List )) Krs_RestOps:List => Krs_RestOps:List </ops>
    <obs> Obs:List => Obs:List ListItem(refused ( ListItem(outsideCapability) )) </obs>
    requires (T:Int ==Int 0) orElseBool (notBool nodupB ( senders ( Partials:List ) ))
  // KRS split-envelope-reference/src/lib.rs: done
  rule [done]:
    <k> # run => .K ... </k>
    <ops> .List </ops>
  // KRS split-envelope-reference/src/lib.rs: header
  rule [header]:
    <k> # run ... </k>
    <params> params ( Mode:Mode , _ ) </params>
    <ops> ListItem(header ( Hdr:Header )) Krs_RestOps:List => Krs_RestOps:List </ops>
    <obs> Obs:List => Obs:List ListItem(faults ( headerFaults ( Mode:Mode , Hdr:Header ) )) </obs>
    requires headerInDomain ( Hdr:Header )
  // KRS split-envelope-reference/src/lib.rs: header_outside
  rule [header-outside]:
    <k> # run ... </k>
    <ops> ListItem(header ( Hdr:Header )) Krs_RestOps:List => Krs_RestOps:List </ops>
    <obs> Obs:List => Obs:List ListItem(refused ( ListItem(outsideCapability) )) </obs>
    requires notBool headerInDomain ( Hdr:Header )
  // KRS split-envelope-reference/src/lib.rs: order_check
  rule [order-check]:
    <k> # run ... </k>
    <params> params ( _ , DeltaC:Int ) </params>
    <ops> ListItem(orderCheck ( Exp:Int , B:Int )) Krs_RestOps:List => Krs_RestOps:List </ops>
    <obs> Obs:List => Obs:List ListItem(ok) </obs>
    requires windowInside ( B:Int , DeltaC:Int , Exp:Int )
  // KRS split-envelope-reference/src/lib.rs: order_check_refused
  rule [order-check-refused]:
    <k> # run ... </k>
    <params> params ( _ , DeltaC:Int ) </params>
    <ops> ListItem(orderCheck ( Exp:Int , B:Int )) Krs_RestOps:List => Krs_RestOps:List </ops>
    <obs> Obs:List => Obs:List ListItem(refused ( ListItem(exp_c_not_below_exp) )) </obs>
    requires notBool windowInside ( B:Int , DeltaC:Int , Exp:Int )
  // KRS split-envelope-reference/src/lib.rs: set_epochs
  rule [set-epochs]:
    <k> # run ... </k>
    <epochs> _ => Es:List </epochs>
    <ops> ListItem(setEpochs ( Es:List )) Krs_RestOps:List => Krs_RestOps:List </ops>
