  // KRS split-envelope-reference/src/lib.rs: submit_refuse
  rule [submit-refuse]:
    <k> # run ... </k>
    <params> params ( _ , DeltaC:Int ) </params>
    <epochs> Epochs:List </epochs>
    <height> Height:Int </height>
    <seen> Seen:List </seen>
    <ops> ListItem(submit ( E:Envelope )) Krs_RestOps:List => Krs_RestOps:List </ops>
    <obs> Obs:List => Obs:List ListItem(refused ( publicRefusals ( Epochs:List , Height:Int , DeltaC:Int , Seen:List , E:Envelope ) )) </obs>
    requires size(publicRefusals ( Epochs:List , Height:Int , DeltaC:Int , Seen:List , E:Envelope )) =/=Int 0
  // KRS split-envelope-reference/src/lib.rs: tick
  rule [tick]:
    <k> # run ... </k>
    <height> Height:Int => H:Int </height>
    <ops> ListItem(tick ( H:Int )) Krs_RestOps:List => Krs_RestOps:List </ops>
    <obs> Obs:List => Obs:List ListItem(ok) </obs>
    requires H:Int >=Int Height:Int
  // KRS split-envelope-reference/src/lib.rs: tick_back
  rule [tick-back]:
    <k> # run ... </k>
    <height> Height:Int </height>
    <ops> ListItem(tick ( H:Int )) Krs_RestOps:List => Krs_RestOps:List </ops>
    <obs> Obs:List => Obs:List ListItem(refused ( ListItem(noRule) )) </obs>
    requires H:Int <Int Height:Int
endmodule
