    requires notBool (Out:Outcome =/=K VOID) [label(split_checkpoint--void_leaf_kept_2)]
  // KRS split-checkpoint-reference/src/lib.rs: WOf, branch 1
  rule wOf ( params ( N:Int , F:Int , _ , _ , _ , _ ) ) => (N:Int -Int 1) -Int F:Int [label(split_checkpoint--w_of_1)]
  // KRS split-checkpoint-reference/src/lib.rs: WholeRestart
  rule wholeRestart ( P:Params , Tickets:List , C:Cp ) => countEq ( 0 , nOf ( P:Params ) , Tickets:List , cpCounters ( C:Cp ) ) <Int (wOf ( P:Params ) +Int 1) [label(split_checkpoint--whole_restart)]
  // KRS split-checkpoint-reference/src/lib.rs: WithRestartSeq, branch 1
  rule withRestartSeq ( cp ( Seq:Int , Epoch:Int , BoardHeight:Int , BoardRoot:Int , WitnessRoot:Int , Pools:List , Settle:List , Bf:List , BootCounters:List , _ , SeatRoots:List , Restores:List ) , V:Int ) => cp ( Seq:Int , Epoch:Int , BoardHeight:Int , BoardRoot:Int , WitnessRoot:Int , Pools:List , Settle:List , Bf:List , BootCounters:List , V:Int , SeatRoots:List , Restores:List ) [label(split_checkpoint--with_restart_seq_1)]
endmodule
