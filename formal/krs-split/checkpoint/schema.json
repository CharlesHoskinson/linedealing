{
  "capability": "split-checkpoint",
  "types": {
    "NN": {"tuple": "P", "items": ["int", "int"], "names": ["a", "b"]},
    "Mode": {"enum": {"TEE": "Tee", "NON_TEE": "NonTee"}},
    "Outcome": {"enum": {"FINAL": "Final", "VOID": "Void", "RELEASED": "Released"}},
    "Params": {"record": "Params", "fields": [
      ["n", "n", "int"], ["f", "f", "int"], ["mode", "mode", {"ref": "Mode"}], ["B", "bb", "int"],
      ["slot_anchor", "slot_anchor", "bool"], ["d_rec", "d_rec", "int"]]},
    "Pool": {"record": "PoolOf", "fields": [
      ["pool", "pool", "int"], ["h", "h", "int"], ["pending_min", "pending_min", "int"],
      ["pending", "pending", {"list": "int"}], ["pending_count", "pending_count", "int"]]},
    "Restore": {"record": "Rd", "fields": [
      ["node_index", "seat", "int"], ["boot_ctr", "boot_ctr", "int"], ["cp_seq", "cp_seq", "int"],
      ["whole_restart", "whole", "bool"]]},
    "Leaf": {"tuple": "Lf", "items": ["int", {"ref": "Outcome"}], "names": ["auth", "out"]},
    "Entry": {"variant": {"tag": "kind", "cases": {
      "bind": ["Bind", [["nf", "nf", "int"], ["e", "e", "int"]]],
      "put": ["Put", [["digest", "digest", "int"]]],
      "restore": ["RestoreE", [["restore", "r", {"ref": "Restore"}]]],
      "release": ["ReleaseE", [["eid", "eid", "int"], ["g", "g", "int"]]]}}},
    "SeatRoot": {"tuple": "Sr", "items": ["int", {"list": {"ref": "Entry"}}], "names": ["seat", "log"]},
    "Cp": {"record": "CpOf", "fields": [
      ["seq", "seq", "int"], ["epoch", "epoch", "int"], ["board_height", "board_height", "int"],
      ["board_root", "board_root", "int"], ["witness_root", "witness_root", "int"],
      ["pools", "pools", {"list": {"ref": "Pool"}}], ["settle_root", "settle", {"list": {"ref": "Leaf"}}],
      ["bf_root", "bf", {"list": {"ref": "NN"}}], ["boot_counters", "boot_counters", {"list": {"ref": "NN"}}],
      ["restart_seq", "restart_seq", "int"], ["seat_roots", "seat_roots", {"list": {"ref": "SeatRoot"}}],
      ["restores", "restores", {"list": {"ref": "Restore"}}]]},
    "ASlot": {"union": {"strings": {"free": "Free", "burned": "Burned"},
                        "keyed": {"bound": ["Bound", [[null, "d", "int"]]]}}},
    "Acct": {"record": "AcctOf", "fields": [
      ["id", "id", "int"], ["slots", "slots", {"list": {"ref": "ASlot"}}], ["mark", "mark", "int"],
      ["refill", "refill", "bool"]]},
    "Write": {"union": {"strings": {"checkpoint": "WCheckpoint", "event": "WEvent"},
                        "keyed": {"eks": ["WEks", [[null, "e", "int"]]]}}},
    "Range": {"record": "Rg", "fields": [["pool", "pool", "int"], ["lo", "lo", "int"], ["hi", "hi", "int"]]},
    "Session": {"tuple": "Sess", "items": ["int", {"list": {"ref": "Range"}}], "names": ["pool", "burned"]},
    "Cov": {"record": "CovOf", "fields": [["account", "account", "int"], ["slot", "slot", "int"], ["d", "d", "int"]]},
    "RSlot": {"record": "RSlotOf", "fields": [
      ["seat", "seat", "int"], ["slot", "slot", "int"], ["covered", "covered", "bool"], ["log_read", "log_read", "bool"]]},
    "Refusal": {"enum": {"below_floor": "BelowFloor", "h_lowered": "HLowered", "ledger_unverified": "LedgerUnverified",
                         "no-rule": "NoRule", "no_restore_statement": "NoRestoreStatement",
                         "outside-capability": "OutsideCapability", "pending_gap": "PendingGap",
                         "pending_min_lowered": "PendingMinLowered",
                         "recovery_early": "RecoveryEarly", "restart_jump": "RestartJump"}},
    "Op": {"variant": {"tag": "op", "cases": {
      "land": ["Land", [["checkpoint", "c", {"ref": "Cp"}], ["midnight_height", "mh", "int"]]],
      "boot": ["Boot", []],
      "read_ledger": ["ReadLedger", [["ok", "ok", "bool"], ["tickets", "tickets", {"list": {"ref": "NN"}}],
                                     ["covered", "cov", {"list": {"ref": "Cov"}}]]],
      "open_session": ["OpenSession", [["pool", "pool", "int"]]],
      "open_account": ["OpenAcct", [["account", "a", {"ref": "Acct"}]]],
      "bind_account": ["BindAcct", [["account", "aid", "int"], ["slot", "i", "int"], ["d", "d", "int"]]],
      "restore_done": ["RestoreDone", [["restore", "r", {"ref": "Restore"}]]],
      "lose_tail": ["LoseTail", []],
      "recover": ["Recover", [["midnight_height", "mh", "int"]]],
      "cold_start": ["ColdStart", [["intact", "intact", "int"], ["signers", "signers", "int"]]],
      "eks": ["Eks", [["epoch", "e", "int"], ["acks", "acks", {"list": "int"}], ["sigs", "sigs", "int"]]],
      "non_tee_restart": ["NonTeeRestart", []],
      "sign_bf": ["SignBf", [["leaves", "leaves", {"list": {"ref": "NN"}}]]],
      "sign_settle": ["SignSettle", [["leaves", "leaves", {"list": {"ref": "Leaf"}}],
                                     ["ended", "ended", {"list": {"ref": "Leaf"}}],
                                     ["midnight_void", "mv", {"list": "int"}]]],
      "sign_pending": ["SignPending", [["pool", "p", {"ref": "Pool"}], ["live", "live", {"list": "int"}]]],
      "sign_seat_root": ["SignSeatRoot", [["log", "log", {"list": {"ref": "Entry"}}]]],
      "order_request": ["OrderReq", [["order_height", "order_h", "int"], ["peer_heights", "peers", {"list": "int"}],
                                     ["proof", "proof", "bool"]]],
      "covered": ["CoveredQ", [["height", "h", "int"]]],
      "release_anchor": ["ReleaseAnchor", [["anchor", "anchor", "bool"], ["entry_height", "entry_h", "int"]]],
      "reshare": ["Reshare", [["slots", "slots", {"list": {"ref": "RSlot"}}]]],
      "due": ["Due", [["last", "last", "int"], ["now", "now", "int"]]],
      "may_reboot": ["MayReboot", []]}}},
    "Obs": {"keyed": {
      "ok": ["Ok", null],
      "refused": ["Refused", [[null, "codes", {"list": {"ref": "Refusal"}}]]],
      "bool": ["BoolObs", [[null, "b", "bool"]]],
      "slots": ["SlotsObs", [[null, "xs", {"list": {"ref": "NN"}}]]]}}
  },
  "inputs": [
    ["params", {"ref": "Params"}],
    ["ops", {"list": {"ref": "Op"}}]
  ],
  "state": [
    ["params", "params", {"ref": "Params"}],
    ["chain", "chain", {"list": {"ref": "Cp"}}],
    ["last_land_mh", "landmh", "int"],
    ["recovered", "recovered", "bool"],
    ["writes", "writes", {"list": {"ref": "Write"}}],
    ["ready", "ready", "bool"],
    ["tickets", "tickets", {"list": {"ref": "NN"}}],
    ["burn", "burn", {"list": {"ref": "Range"}}],
    ["accounts", "accounts", {"list": {"ref": "Acct"}}],
    ["sessions", "sessions", {"list": {"ref": "Session"}}],
    ["restart_open", "restarting", "bool"],
    ["marker_prev", "marker", "int"],
    ["marker_landed", "landed", "bool"],
    ["pending_restores", "waiting", {"list": {"ref": "Restore"}}],
    ["board_restores", "board", {"list": {"ref": "Restore"}}],
    ["cold_started", "cold", "bool"],
    ["new_pool", "newpool", "bool"]
  ],
  "obs": {"ref": "Obs"}
}
