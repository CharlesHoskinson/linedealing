{
  "capability": "split-request",
  "types": {
    "Mode": {"enum": {"TEE": "Tee", "NON_TEE": "NonTee"}},
    "Phase": {"enum": {"POSTED": "Posted", "ORDERED": "Ordered", "OPENED": "Opened", "COLLECTING": "Collecting",
                       "ADMITTED": "Admitted", "FINAL": "Final", "VOID": "Void", "EXPIRED": "Expired"}},
    "Outcome": {"enum": {"NONE": "ONone", "FINAL": "OFinal", "VOID": "OVoid", "RELEASED": "OReleased"}},
    "Reason": {"enum": {"NONE": "RNone", "SHARE_COMPLAINT": "ShareComplaint", "MALFORMED": "Malformed",
                        "AUTH_REFUSED": "AuthRefused", "REVOKED": "Revoked", "RELEASE_CHECK": "ReleaseCheck",
                        "CONTRIBUTION": "Contribution", "DEALER_FAULT": "DealerFault", "PIN_SPENT": "PinSpent",
                        "SLOT_TAKEN": "SlotTaken", "STALLED": "Stalled", "RESTART": "Restart", "MIXED": "Mixed"}},
    "RType": {"enum": {"SPEND": "Spend", "EXIT": "Exit", "SEIZURE": "Seizure", "BIRTH": "Birth",
                       "REFILL": "Refill", "P0": "TyP0", "CONTRIB": "Contrib"}},
    "Profile": {"enum": {"P0": "PfP0", "P1": "PfP1", "P2": "PfP2"}},
    "Params": {"record": "Pm", "fields": [
      ["n", "n", "int"], ["f", "f", "int"], ["delta_c", "delta_c", "int"], ["delta_hold", "delta_hold", "int"],
      ["mode", "mode", {"ref": "Mode"}]]},
    "Epoch": {"record": "Ep", "fields": [["e", "e", "int"], ["n", "n", "int"], ["f", "f", "int"]]},
    "Med": {"record": "Md", "fields": [["h", "h", "int"], ["m", "m", "int"]]},
    "Frame": {"record": "Fr", "fields": [
      ["position", "position", "int"], ["token_ok", "token_ok", "bool"], ["lengths_ok", "lengths_ok", "bool"],
      ["height", "height", "int"], ["cid", "cid", "int"]]},
    "Vote2": {"record": "V2", "fields": [["node", "node", "int"], ["hash", "hash", "int"]]},
    "Vote3": {"record": "V3", "fields": [["node", "node", "int"], ["hash", "hash", "int"], ["h", "h", "int"]]},
    "FinPost": {"record": "Fp", "fields": [["epoch", "epoch", "int"], ["member", "member", "int"], ["ct", "ct", "int"]]},
    "VoidPost": {"record": "Vp", "fields": [["epoch", "epoch", "int"], ["member", "member", "int"],
                                            ["reason", "reason", {"ref": "Reason"}]]},
    "ON": {"option": "int"},
    "Req": {"record": "Rq", "fields": [
      ["eid", "eid", "int"], ["epoch", "epoch", "int"], ["exp", "exp", "int"], ["type", "rtype", {"ref": "RType"}],
      ["profile", "profile", {"ref": "Profile"}], ["order_pos", "order_pos", {"ref": "ON"}],
      ["exp_c", "exp_c", {"ref": "ON"}], ["phase", "phase", {"ref": "Phase"}], ["reason", "reason", {"ref": "Reason"}],
      ["collecting", "collecting", "bool"], ["K", "kk", "int"], ["L", "ll", "int"], ["G", "gg", "int"],
      ["anchor", "anchor", {"list": {"ref": "ON"}}], ["released", "released", {"list": {"ref": "ON"}}],
      ["any_release", "any_release", "bool"], ["restart_end", "restart_end", "bool"],
      ["outcome", "outcome", {"ref": "Outcome"}], ["rates", "rates", {"list": "int"}],
      ["positions", "positions", {"list": {"ref": "ON"}}], ["held", "held", {"list": {"ref": "Frame"}}],
      ["opened_votes", "opened_votes", {"list": {"ref": "Vote2"}}],
      ["admit_votes", "admit_votes", {"list": {"ref": "Vote3"}}],
      ["early_complaint", "early_complaint", "bool"], ["dealer_fault", "dealer_fault", "bool"],
      ["final_posts", "final_posts", {"list": {"ref": "FinPost"}}],
      ["void_posts", "void_posts", {"list": {"ref": "VoidPost"}}],
      ["end_height", "end_height", {"ref": "ON"}], ["confirmed", "confirmed", "bool"], ["carried", "carried", "bool"]]},
    "Refusal": {"enum": {"exp_c_not_below_exp": "ExpCNotBelowExp", "late_contribution": "LateContribution", "no-rule": "NoRule", "no_qc": "NoQc",
                         "outside-capability": "OutsideCapability", "position_filled": "PositionFilled",
                         "settled": "Settled", "terminal": "Terminal", "unknown_epoch": "UnknownEpoch",
                         "unknown_request": "UnknownRequest"}},
    "Op": {"variant": {"tag": "op", "cases": {
      "post": ["Post", [["eid", "eid", "int"], ["epoch", "epoch", "int"], ["exp", "exp", "int"],
                        ["type", "rtype", {"ref": "RType"}], ["profile", "profile", {"ref": "Profile"}]]],
      "order": ["Order", [["eid", "eid", "int"], ["qc", "qc", "bool"], ["p", "p", "int"]]],
      "open": ["Open", [["eid", "eid", "int"], ["K", "kk", "int"], ["L", "ll", "int"], ["collecting", "collecting", "bool"],
                        ["positions", "npos", "int"], ["rates", "rates", {"list": "int"}]]],
      "complaint": ["Complaint", [["eid", "eid", "int"]]],
      "frame": ["FrameOp", [["eid", "eid", "int"], ["frame", "fr", {"ref": "Frame"}]]],
      "detach": ["Detach", [["eid", "eid", "int"], ["position", "position", "int"]]],
      "vote_opened": ["VoteOpened", [["eid", "eid", "int"], ["node", "node", "int"], ["hash", "hash", "int"]]],
      "vote_admit": ["VoteAdmit", [["eid", "eid", "int"], ["node", "node", "int"], ["hash", "hash", "int"],
                                   ["h", "h", "int"]]],
      "obs2": ["Obs2", [["eid", "eid", "int"], ["gen1_missed", "gen1_missed", "bool"],
                        ["heights", "heights", {"list": "int"}]]],
      "release": ["Release", [["eid", "eid", "int"], ["g", "g", "int"], ["j", "j", "int"]]],
      "post_final": ["PostFinal", [["eid", "eid", "int"], ["epoch", "epoch", "int"], ["member", "member", "int"],
                                   ["ct", "ct", "int"]]],
      "post_void": ["PostVoid", [["eid", "eid", "int"], ["epoch", "epoch", "int"], ["member", "member", "int"],
                                 ["reason", "reason", {"ref": "Reason"}]]],
      "tick": ["Tick", [["height", "h", "int"]]],
      "rotate": ["Rotate", [["e", "e", "int"], ["n", "n", "int"], ["f", "f", "int"]]],
      "land_checkpoint": ["LandCp", [["height", "h", "int"]]],
      "restart_burn": ["RestartBurn", [["eid", "eid", "int"]]],
      "confirm": ["Confirm", [["eid", "eid", "int"]]],
      "carry": ["Carry", [["eid", "eid", "int"]]],
      "host_fee": ["HostFee", [["h", "h", "int"], ["m", "m", "int"]]]}}},
    "Obs": {"keyed": {
      "ok": ["Ok", null],
      "refused": ["Refused", [[null, "codes", {"list": {"ref": "Refusal"}}]]],
      "phase": ["PhaseIs", [[null, "p", {"ref": "Phase"}]]]}}
  },
  "inputs": [
    ["params", {"ref": "Params"}],
    ["epochs", {"list": {"ref": "Epoch"}}],
    ["ops", {"list": {"ref": "Op"}}]
  ],
  "state": [
    ["params", "params", {"ref": "Params"}],
    ["height", "height", "int"],
    ["cp_height", "cpheight", "int"],
    ["epochs", "epochs", {"list": {"ref": "Epoch"}}],
    ["host_med", "hostmed", {"list": {"ref": "Med"}}],
    ["requests", "requests", {"list": {"ref": "Req"}}]
  ],
  "obs": {"ref": "Obs"}
}
