// -*- mode: Bluespec; -*-
// Replay of the revision 3 random traces of finding F6 on the NON_TEE path (DECISIONS 64).
// Source: `quint run splitspec.qnt --main nontee_p1 --init initArmed --step stepRestart` on the
// revision 3 model (commit 2fab671) with the invariant not(w_stalled_after_release), 10000 samples,
// 80 steps, 10 threads, seeds 0x14 and 0x2a3. Both seeds return the same 51-state schedule
// (traces-sample/f6_nontee_p1_rev3/). Honest member 4 posts VOID STALLED for collecting request 1
// at board height 12 (exp_c = 9, step 32); step 41 is admit(1) with variant 2 at height 16; step 48
// records the RELEASE of generation 1; step 50 is the corrupt STALLED post of member 1 that forms
// the tombstone. State 40 is the state before step 41, loaded from the ITF file
// (tools/itf2qnt.py); revision 4 changes only the tombstone reason, so the same steps 0 to 40
// reach it in revision 4. Steps 41 to 50 are replayed as actions.
//
// Urgent expiry (RQ-046, lead ruling A on the item 14 replay): request 1 has exp = 16. The recorded
// step 46 ticks the board to 17, which now expires request 1 with any_release = false (outcome
// VOID), so step 48 (record_release at height 18) and step 50 are refused as terminal (RQ-005):
// the recorded suffix is moot. Steps 0 to 40 contain no late expire, no frame for an OPENED target
// (the frame of step 14 is held while ORDERED at height 6 <= exp_c = 9) and no restart, so state
// 40 is still reachable. F6 stands on the NON_TEE path through a shorter suffix at height 16 = exp:
// admit (step 41), record_release (step 48) and the corrupt STALLED post (step 50) without the
// ticks in between (replayF6Seed*UrgentTest; the mutant reaches STALLED on it).
module replay_f6_base {
  import splitspec(MODE = "NON_TEE", PROFILE = "P1", MUT = "none").* from "./splitspec"
  pure val s40_st = { auths: Map(1 -> { auth: 1, coin: 1, final_height: 0, nf: 1, pin: 1, settled: "NONE", status: "FINAL" }), board_height: 16, checkpoints: 6, committee_txs: 7, cp: { board_height: 14, h: 0, pending: Set((1, 1), (2, 1)), pending_count: 2, pending_min: 1, restart_seq: 0, seq: 6, settle_root: Set() }, cslots: Map(1 -> { bstat: "RESERVED", namers: Set(1), prec: 1, rsv: true }, 2 -> { bstat: "RESERVED", namers: Set(1), prec: 1, rsv: true }, 3 -> { bstat: "UNNAMED", namers: Set(), prec: 0, rsv: false }, 4 -> { bstat: "UNNAMED", namers: Set(), prec: 0, rsv: false }), eks_writes: 1, epochs: Set(1, 2), eslots: Map(1 -> { bstat: "UNNAMED", namers: Set(3), prec: 0, reserver: 0, root: "OWN" }, 2 -> { bstat: "UNNAMED", namers: Set(3), prec: 0, reserver: 0, root: "OWN" }, 3 -> { bstat: "UNNAMED", namers: Set(), prec: 0, reserver: 0, root: "G" }), held: Map(), host_spent: Set(), midnight_height: 8, posts: Set({ eid: 1, epoch: 1, kind: "VOID", member: 4, reason: "STALLED" }, { eid: 1, epoch: 2, kind: "FINAL", member: 1, reason: "NONE" }, { eid: 1, epoch: 2, kind: "VOID", member: 1, reason: "SLOT_TAKEN" }, { eid: 2, epoch: 1, kind: "FINAL", member: 1, reason: "NONE" }, { eid: 2, epoch: 1, kind: "VOID", member: 1, reason: "REVOKED" }, { eid: 2, epoch: 2, kind: "FINAL", member: 1, reason: "NONE" }, { eid: 2, epoch: 2, kind: "VOID", member: 1, reason: "MALFORMED" }, { eid: 3, epoch: 1, kind: "VOID", member: 1, reason: "DEALER_FAULT" }, { eid: 3, epoch: 2, kind: "FINAL", member: 1, reason: "NONE" }, { eid: 3, epoch: 2, kind: "VOID", member: 1, reason: "SLOT_TAKEN" }), record: { coin: 1, hold_set: false, next_nf: 2, next_pin: 2, nf: 1, nf_used: true, pending_auth: 1, pin: -1, rstate: "PENDING" }, requests: Map(1 -> { G: 2, K: 2, L: 1, anchor: Map(1 -> 0, 2 -> 0), any_release: false, collecting: true, complaint: "none", cslot: Map(1 -> 1, 2 -> 2), dealer_fault_recorded: false, eid: 1, end_height: -1, epoch: 1, eslot: Map(1 -> 1, 2 -> 2), exp: 16, exp_c: 9, fault: "none"