  pure val e50_st = { auths: Map(1 -> { auth: 1, coin: 1, final_height: 0, nf: 1, pin: 1, settled: "NONE", status: "FINAL" }), board_height: 19, checkpoints: 6, committee_txs: 7, cp: { board_height: 14, h: 0, pending: Set((1, 1), (2, 1)), pending_count: 2, pending_min: 1, restart_seq: 0, seq: 6, settle_root: Set() }, cslots: Map(1 -> { bstat: "BURNED", namers: Set(1), prec: 1, rsv: true }, 2 -> { bstat: "BURNED", namers: Set(1), prec: 1, rsv: true }, 3 -> { bstat: "UNNAMED", namers: Set(), prec: 0, rsv: false }, 4 -> { bstat: "UNNAMED", namers: Set(), prec: 0, rsv: false }), eks_writes: 1, epochs: Set(1, 2), eslots: Map(1 -> { bstat: "UNNAMED", namers: Set(3), prec: 0, reserver: 0, root: "OWN" }, 2 -> { bstat: "UNNAMED", namers: Set(3), prec: 0, reserver: 0, root: "OWN" }, 3 -> { bstat: "UNNAMED", namers: Set(), prec: 0, reserver: 0, root: "G" }), held: Map(), host_spent: Set(), midnight_height: 10, posts: Set({ eid: 1, epoch: 1, kind: "FINAL", member: 1, reason: "NONE" }, { eid: 1, epoch: 1, kind: "VOID", member: 1, reason: "STALLED" }, { eid: 1, epoch: 1, kind: "VOID", member: 4, reason: "STALLED" }, { eid: 1, epoch: 2, kind: "FINAL", member: 1, reason: "NONE" }, { eid: 1, epoch: 2, kind: "VOID", member: 1, reason: "SLOT_TAKEN" }, { eid: 2, epoch: 1, kind: "FINAL", member: 1, reason: "NONE" }, { eid: 2, epoch: 1, kind: "VOID", member: 1, reason: "REVOKED" }, { eid: 2, epoch: 2, kind: "FINAL", member: 1, reason: "NONE" }, { eid: 2, epoch: 2, kind: "VOID", member: 1, reason: "MALFORMED" }, { eid: 3, epoch: 1, kind: "FINAL", member: 1, reason: "NONE" }, { eid: 3, epoch: 1, kind: "VOID", member: 1, reason: "DEALER_FAULT" }, { eid: 3, epoch: 2, kind: "FINAL", member: 1, reason: "NONE" }, { eid: 3, epoch: 2, kind: "VOID", member: 1, reason: "SLOT_TAKEN" }), record: { coin: 1, hold_set: false, next_nf: 2, next_pin: 2, nf: 1, nf_used: true, pending_auth: 1, pin: -1, rstate: "PENDING" }, requests: Map(1 -> { G: 2, K: 2, L: 1, anchor: Map(1 -> 2, 2 -> 0), any_release: true, collecting: true, complaint: "none", cslot: Map(1 -> 1, 2 -> 2), dealer_fault_recorded: false, eid: 1, end_height: 19, epoch: 1, eslot: Map(1 -> 1, 2 -> 2), exp: 16, exp_c: 9, fault: "none", filled: true, frame_held: true, hdr_open: true, lapsed: false, order_pos: 5, outcome: "RELEASED", phase: "VOID", profile: "P1", reason: "STALLED", release_height: 18, released: Map(1 -> 2, 2 -> 0), req_type: "SPEND", restart_end: false, source: "OWNER", suite: "SCHNORR" }, 2 -> { G: 1, K: 1, L: 1, anchor: Map(1 -> 0, 2 -> 0), any_release: false, collecting: false, complaint: "none", cslot: Map(1 -> 2, 2 -> 1), dealer_fault_recorded: false, eid: 2, end_height: -1, epoch: 1, eslot: Map(1 -> 3, 2 -> 2), exp: 16, exp_c: -1, fault: "none", filled: false, frame_held: false, hdr_open: false, lapsed: false, order_pos: -1, outcome: "NONE", phase: "POSTED", profile: "P1", reason: "NONE", release_height: -1, released: Map(1 -> 0, 2 -> 0), req_type: "SPEND", restart_end: false, source: "OWNER", suite: "SCHNORR" }, 3 -> { G: 2, K: 2, L: 1, anchor: Map(1 -> 0, 2 -> 0), any_release: false, collecting: false, complaint: "none", cslot: Map(1 -> 3, 2 -> 2), dealer_fault_recorded: false, eid: 3, end_height: -1, epoch: 1, eslot: Map(1 -> 1, 2 -> 2), exp: 18, exp_c: 10, fault: "none", filled: false, frame_held: false, hdr_open: true, lapsed: true, order_pos: 6, outcome: "NONE", phase: "OPENED", profile: "P1", reason: "NONE", release_height: -1, released: Map(1 -> 0, 2 -> 0), req_type: "SPEND", restart_end: false, source: "OWNER", suite: "ECDSA" }), restart_open: false, restarts: 0, signed_leaf: Map(1 -> "RELEASED"), addr: { registered: false, ec_ok: false, ack_env: "NONE", ack_ok: Set(), acked: false, paid: false } }
  pure val e50_g = { admitted: Set(1), burn_hi: -1, burn_lo: 0, burned_pending: 0, burned_usable: 0, cp_prev: { board_height: 10, h: 0, pending: Set((1, 1), (2, 1)), pending_count: 2, pending_min: 1, restart_seq: 0, seq: 5, settle_root: Set() }, eburn_restart: Set(), first_after_restart: false, hdr_sent: Set(1, 3), held_changed: false, honest_void: Set((1, "STALLED")), restart_hit: Set(), sent: Set(), sent_revoked: Set(), slot_tickets: Set(), taken_by: Set(), rel_seen: Set((1, 1, 2)), adm_posts: Set() }
  pure val e50_lastOp = { arg: 11, code: "", eid: 1, kind: "post_void" }

  action load(s: State, gg: Ghost, op: Op): bool = all { st' = s, g' = gg, lastOp' = op }
  // The revision 3 end state (state 50) breaks the revision 4 invariant.
  run replayF6Rev3EndStateTest =
    load(e50_st, e50_g, e50_lastOp)
      .expect(and { req(1).reason == "STALLED", req(1).any_release, req(1).outcome == "RELEASED",
                    not(inv_RQ073_C20_noStalledAfterRelease) })
  // Steps 41 to 46 as recorded: the tick of step 46 expires request 1 (RQ-046, urgent) before any
  // RELEASE, so it settles VOID and the recorded step 48 is refused (RQ-005).
  run replayF6Seed14RecordedTest =
    load(s40_st, s40_g, s40_lastOp)
      .expect(and { inv, req(1).phase == "COLLECTING", st.board_height >= req(1).exp_c,
                    st.board_height == req(1).exp,
                    st.posts.contains({ eid: 1, epoch: 1, member: 4, kind: "VOID", reason: "STALLED" }) })
      .then(admitWith(1, 2)).then(tickMidnight).then(tickMidnight)
      .then(postFinal(3, 1, 1)).then(postFinal(1, 1, 1)).then(tick)
      .expect(and { req(1).phase == "EXPIRED", req(1).outcome == "VOID", not(req(1).any_release),
                    req(1).end_height == 17, inv })
  run replayF6Seed14RecordedBlocked1Test =
    load(s40_st, s40_g, s40_lastOp)
      .then(admitWith(1, 2)).then(tickMidnight).then(tickMidnight)
      .then(postFinal(3, 1, 1)).then(postFinal(1, 1, 1)).then(tick).then(tick)
      .then(recordRelease(1, 1).fail())
  // The F6 path under urgent expiry: steps 41, 48 and 50 at height 16 (= exp, not past it). Late
  // admission stays allowed (DECISIONS 64); the reason is MIXED and the outcome RELEASED.
  run replayF6Seed14UrgentTest =
    load(s40_st, s40_g, s40_lastOp)
      .then(admitWith(1, 2)).then(recordRelease(1, 1))
      .then(postVoid(1, 1, 1, "STALLED"))
      .expect(and { st.board_height == 16, req(1).phase == "VOID", req(1).reason == "MIXED",
                    req(1).outcome == "RELEASED", req(1).any_release, inv })
  run replayF6Seed2a3UrgentTest =
    load(b40_st, b40_g, b40_lastOp)
      .then(admitWith(1, 2)).then(recordRelease(1, 1))
      .then(postVoid(1, 1, 1, "STALLED"))
      .expect(and { req(1).phase == "VOID", req(1).reason == "MIXED", req(1).outcome == "RELEASED", inv })
}
